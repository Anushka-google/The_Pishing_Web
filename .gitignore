data/raw/legitimate/*
!data/raw/legitimate/.gitkeep
data/processed/*.csv
!data/processed/.gitkeep
data/real_world/*.csv
data/*.db
*.db

# Large serialized model files
models/*.pkl
models/*.joblib
models/*.onnx
!models/.gitkeep

