# MLflow tracking data (keep config/scripts, ignore local run logs)
mlruns/
mlartifacts/

# Dataset files: Ignore transient databases and large dumps, but track project datasets
*.db
data/*.db
data/raw/phishing/*
!data/raw/phishing/.gitkeep
!data/raw/phishing/phishing_urls.csv
data/raw/legitimate/*
!data/raw/legitimate/.gitkeep
!data/raw/legitimate/legitimate_urls.csv
!data/processed/*.csv
!data/real_world/*.csv

# Model files: Track production joblib artifacts and version manifests, ignore transient pickles
models/*.pkl
models/*.onnx
!models/.gitkeep
!models/*.joblib


# Node / Frontend build (for Phase 18+)
frontend/node_modules/
frontend/build/
frontend/dist/
frontend/.next/

# Structured logs
logs/*.log
!logs/.gitkeep
